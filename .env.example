APP_NAME=devtools
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Dev local e producao usam MariaDB (ver docs/RUNBOOK.md).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=devtools
DB_USERNAME=devtools
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie de sessao so via HTTPS. Padrao: true quando APP_ENV=production.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# O worker do supervisor usa --timeout=120; o retry_after precisa ficar acima
# disso para um job longo nao ser reprocessado. Ordem: 60 (provedor) < 90
# (job) < 120 (worker) < 150 (retry_after).
DB_QUEUE_RETRY_AFTER=150

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Producao: SMTP generico (usuario escolhe o provedor). Local: "log" escreve o
# e-mail em storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Remetente dos e-mails transacionais (reset, verificacao, newsletter).
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Paginas legais: contato de privacidade e data da ultima revisao dos textos.
# Sem LEGAL_CONTACT_EMAIL, o contato cai no MAIL_FROM_ADDRESS.
LEGAL_CONTACT_EMAIL=
LEGAL_UPDATED_AT=2026-10-20

# E-mail de destino das mensagens da pagina de contato (Fale conosco).
CONTACT_EMAIL=devtools@natanfiuza.dev.br

# Medicao (GA4), so depois do aceite no banner (ADR-013). Vazio desliga a
# medicao: sem id, nenhuma tag e injetada nem com aceite.
ANALYTICS_GA4_ID=
# Validade do cookie de consentimento, em dias.
ANALYTICS_CONSENT_DAYS=180

# Login social. Crie os apps OAuth e preencha; enquanto estiver vazio, o botao
# do provedor volta ao login com um aviso (nada quebra).
# Redirect a cadastrar no console: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect a cadastrar no console: ${APP_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SSR da Inertia. Local: false. Producao: true (exige o processo do supervisor, ver docs/RUNBOOK.md).
INERTIA_SSR_ENABLED=false

# IA (F5). Modelo, precos e limites de plano vem daqui e das tabelas - nunca do
# codigo. Sem AI_BASE_URL, AI_MODEL ou AI_API_KEY a tool responde como
# indisponivel (nada quebra e nenhuma chamada sai).
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Tempo da chamada ao provedor (segundos).
AI_TIMEOUT=60
AI_CONNECT_TIMEOUT=10
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2000

# Tetos tecnicos do payload, em bytes/caracteres. O plano pode ser menor.
AI_MAX_SCHEMA_BYTES=65536
AI_MAX_DESCRIPTION_CHARS=4000
AI_MAX_OUTPUT_BYTES=32768
# Estimativa de saida usada na reserva da cota paga.
AI_ESTIMATE_OUTPUT_TOKENS=900

# Cache de respostas e janela de dedupe de solicitacoes em voo.
AI_CACHE_TTL_DAYS=30
AI_INFLIGHT_TTL_SECONDS=600

# Job da fila: timeout, tentativas e espera entre elas (segundos).
AI_JOB_TIMEOUT=90
AI_JOB_TRIES=2
AI_JOB_BACKOFF=5,15
# Folga do ai:reconcile depois do timeout (worker morto sem failed()).
AI_RECONCILE_GRACE_SECONDS=30

# Rate limit: POST por conta (minuto e hora), POST por IP e polling por conta.
AI_RATE_POST_PER_MINUTE=6
AI_RATE_POST_PER_HOUR=60
AI_RATE_POST_PER_MINUTE_IP=30
AI_RATE_POLL_PER_MINUTE=120

# Ritmo do polling na tela (milissegundos).
AI_POLL_INITIAL_MS=1500
AI_POLL_MAX_MS=5000
AI_POLL_TIMEOUT_MS=120000

# Limite de entrada das tools do cliente, em bytes (padrao: 5 MB). Vale para o
# que ja vem digitado: passar dele desliga a analise, sem travar a digitacao.
TOOLS_MAX_INPUT_BYTES=

# A partir de quantas linhas as listas de uma tool passam a renderizar so a
# janela visivel (padrao: 2000). Limiar de desempenho da arvore do JSON Viewer.
TOOLS_VIRTUALIZE_FROM=

# Teto de tempo de uma expressao regular no Regex Tester, em milissegundos
# (padrao: 2000). Ao estourar, a busca e encerrada e nada e mostrado.
TOOLS_REGEX_TIMEOUT_MS=

# Quantos resultados o Regex Tester devolve antes de avisar que cortou
# (padrao: 1000).
TOOLS_REGEX_MAX_MATCHES=

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Pagamentos (Mercado Pago)
# ---------------------------------------------------------------------------
# Sem MERCADO_PAGO_ACCESS_TOKEN o checkout online fica escondido e a pagina de
# assinatura oferece o atendimento manual. Sem MERCADO_PAGO_WEBHOOK_SECRET o
# webhook responde 503 (nao da para validar a assinatura sem segredo).
PAYMENTS_GATEWAY=mercadopago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_TIMEOUT=20
MERCADO_PAGO_CONNECT_TIMEOUT=5

# Tempo de vida de uma sessao de checkout e do QR de doacao (minutos).
PAYMENTS_CHECKOUT_EXPIRES_MINUTES=60

# URLs publicas. Vazias resolvem para as rotas do proprio app.
PAYMENTS_BACK_URL=
PAYMENTS_WEBHOOK_URL=
PAYMENTS_STATEMENT_DESCRIPTOR=DEVTOOLS

# ---------------------------------------------------------------------------
# Doacoes
# ---------------------------------------------------------------------------
DONATIONS_CURRENCY=BRL
# Valores sugeridos e intervalo aceito, em centavos.
DONATIONS_SUGGESTED_CENTS=500,1000,2500,5000
DONATIONS_MIN_CENTS=100
DONATIONS_MAX_CENTS=100000
DONATIONS_EXPIRES_MINUTES=60
# E-mail de pagador usado quando o doador nao informa um.
DONATIONS_PAYER_EMAIL=
DONATIONS_SEND_RECEIPTS=true
# Pix estatico (fallback sem credenciais do provedor).
DONATIONS_PIX_KEY=
DONATIONS_PIX_HOLDER=
DONATIONS_PIX_CITY=

# ---------------------------------------------------------------------------
# Seguranca (F7)
# ---------------------------------------------------------------------------
# Proxies confiaveis (IPs/CIDR separados por virgula). Atras do nginx local,
# use 127.0.0.1; sem proxy, deixe vazio e o X-Forwarded-* e ignorado.
TRUSTED_PROXIES=
# Forca https em todas as URLs geradas (canonical, OG, sitemap). Padrao:
# true quando APP_ENV=production. Local (http): false.
FORCE_HTTPS=false
# Content-Security-Policy: enforce (padrao em producao), report-only (rollback
# operacional quando algo quebrar) ou off (local/dev).
CSP_MODE=off
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# Cloudflare Turnstile no cadastro. Sem as duas chaves o recurso fica desligado
# (o widget nao aparece e a regra passa). Com as chaves, a verificacao falha
# fechada; a secret_key nunca sai do servidor.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
